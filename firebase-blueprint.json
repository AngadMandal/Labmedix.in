{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Patient records and health card holder details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "mobile": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "bloodGroup": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName"]
    },
    "HealthCard": {
      "title": "HealthCard",
      "description": "LabMedix Health Card subscription and wallet details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "cardNumber": { "type": "string", "maxLength": 50 },
        "patientId": { "type": "string", "maxLength": 128 },
        "membershipId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended", "expired", "blocked", "replaced"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "cardNumber", "patientId"]
    },
    "User": {
      "title": "User",
      "description": "Staff and Portal User Accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "username", "role"]
    },
    "CardApplication": {
      "title": "CardApplication",
      "description": "Online Health Card Application and Self-Service Registrations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "trackingId": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending_approval", "approved", "rejected", "info_required"] },
        "membershipId": { "type": "string", "maxLength": 64 },
        "totalPaidAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "status"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Patient and Cardholder Cashless Wallet",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 128 },
        "balance": { "type": "number" },
        "status": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "patientId"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System operational audit and security logs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action"]
    },
    "DeviceSession": {
      "title": "DeviceSession",
      "description": "Authorized connected client devices and multi-device sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "deviceName": { "type": "string", "maxLength": 150 },
        "platform": { "type": "string", "maxLength": 50 },
        "browser": { "type": "string", "maxLength": 50 },
        "os": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["active", "idle", "revoked", "offline"] },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "registeredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "deviceId", "deviceName", "status"]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": { "$ref": "Patient" },
      "description": "Central patients registry"
    },
    "/cards/{cardId}": {
      "schema": { "$ref": "HealthCard" },
      "description": "Central health cards registry"
    },
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "Staff and Portal User Accounts"
    },
    "/cardApplications/{applicationId}": {
      "schema": { "$ref": "CardApplication" },
      "description": "Online Card Application Requests"
    },
    "/wallets/{walletId}": {
      "schema": { "$ref": "Wallet" },
      "description": "Patient Wallets"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "System Audit Logs"
    },
    "/_system_active_devices/{deviceId}": {
      "schema": { "$ref": "DeviceSession" },
      "description": "Active Multi-Device Sessions Registry"
    }
  }
}
